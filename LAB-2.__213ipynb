   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "099a30d7-4d79-4888-a993-0bca8aa6a4db",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Step 1: Given Data\n",
      "Inputs (X): [0.7, 0.6, 0.8, 0.5, 0.4, 0.9]\n",
      "Weights (W): [0.2, 0.4, 0.3, 0.1, 0.2, 0.5]\n",
      "Bias (b): -0.3\n",
      "Target (y): 1\n",
      "\n",
      "Step 2: Net Input\n",
      "z = 0.8999999999999999\n",
      "\n",
      "Step 3: Prediction\n",
      "Predicted Output = 1\n",
      "\n",
      "Step 4: Error\n",
      "Error = 0\n",
      "\n",
      "No Weight Update Needed\n",
      "\n",
      "Step 6: Updated Bias\n",
      "New Bias = -0.3\n",
      "\n",
      "Step 7: After Training\n",
      "New z = 0.8999999999999999\n",
      "New Prediction = 1\n",
      "\n",
      "Final Result:\n",
      "Target Achieved (Pass = 1)\n"
     ]
    }
   ],
   "source": [
    "\n",
    "X = [0.7, 0.6, 0.8, 0.5, 0.4, 0.9]\n",
    "\n",
    "\n",
    "W = [0.2, 0.4, 0.3, 0.1, 0.2, 0.5]\n",
    "\n",
    "b = -0.3\n",
    "\n",
    "lr = 0.1\n",
    "\n",
    "y = 1\n",
    "\n",
    "\n",
    "print(\"Step 1: Given Data\")\n",
    "print(\"Inputs (X):\", X)\n",
    "print(\"Weights (W):\", W)\n",
    "print(\"Bias (b):\", b)\n",
    "print(\"Target (y):\", y)\n",
    "\n",
    "\n",
    "z = 0\n",
    "for i in range(len(X)):\n",
    "    z = z + (X[i] * W[i])\n",
    "\n",
    "z = z + b\n",
    "\n",
    "print(\"\\nStep 2: Net Input\")\n",
    "print(\"z =\", z)\n",
    "\n",
    "\n",
    "if z >= 0:\n",
    "    y_pred = 1\n",
    "else:\n",
    "    y_pred = 0\n",
    "\n",
    "print(\"\\nStep 3: Prediction\")\n",
    "print(\"Predicted Output =\", y_pred)\n",
    "\n",
    "error = y - y_pred\n",
    "\n",
    "print(\"\\nStep 4: Error\")\n",
    "print(\"Error =\", error)\n",
    "\n",
    "\n",
    "# Step 5: Weight Update (if error exists)\n",
    "\n",
    "if error != 0:\n",
    "    for i in range(len(W)):\n",
    "        W[i] = W[i] + (lr * error * X[i])\n",
    "\n",
    "    print(\"\\nStep 5: Updated Weights\")\n",
    "    print(\"New Weights =\", W)\n",
    "else:\n",
    "    print(\"\\nNo Weight Update Needed\")\n",
    "\n",
    "\n",
    "# Step 6: Bias Update\n",
    "\n",
    "b = b + (lr * error)\n",
    "\n",
    "print(\"\\nStep 6: Updated Bias\")\n",
    "print(\"New Bias =\", b)\n",
    "\n",
    "\n",
    "# Step 7: Prediction After Training\n",
    "\n",
    "z_new = 0\n",
    "for i in range(len(X)):\n",
    "    z_new = z_new + (X[i] * W[i])\n",
    "\n",
    "z_new = z_new + b\n",
    "\n",
    "if z_new >= 0:\n",
    "    y_new = 1\n",
    "else:\n",
    "    y_new = 0\n",
    "\n",
    "\n",
    "print(\"\\nStep 7: After Training\")\n",
    "print(\"New z =\", z_new)\n",
    "print(\"New Prediction =\", y_new)\n",
    "\n",
    "\n",
    "# Final Result\n",
    "\n",
    "print(\"\\nFinal Result:\")\n",
    "if y_new == y:\n",
    "    print(\"Target Achieved (Pass = 1)\")\n",
    "else:\n",
    "    print(\"Target Not Achieved\")"
   ]
  },
